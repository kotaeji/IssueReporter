<Window x:Class="IssueReporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IssueReporter"
        Height="700" Width="1000"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="12">
    <DockPanel LastChildFill="True">

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource WindowBackgroundBrush}" Padding="2,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Issue" Click="NewIssue_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Save Draft" Click="SaveDraft_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cu_t" IsEnabled="False"/>
                <MenuItem Header="_Copy" IsEnabled="False"/>
                <MenuItem Header="_Paste" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Click="Refresh_Click" InputGestureText="F5"/>
                <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings" Click="NavSettings_Click"/>
                <MenuItem Header="_Templates" Click="NavTemplates_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About IssueReporter" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource ToolbarBackgroundBrush}">
            <ToolBar Band="0" BandIndex="0" Background="{StaticResource ToolbarBackgroundBrush}" Padding="2">
                <Button Content="New" Style="{StaticResource ToolbarButton}" Click="NewIssue_Click" ToolTip="New Issue"/>
                <Button Content="Save Draft" Style="{StaticResource ToolbarButton}" Click="SaveDraft_Click" ToolTip="Save Draft"/>
                <Button Content="Submit" Style="{StaticResource AccentButton}" Click="Submit_Click" ToolTip="Submit Issue"
                        Margin="2,0" MinWidth="72" Padding="10,4"/>
                <Separator/>
                <Button Content="Attach" Style="{StaticResource ToolbarButton}" Click="Attach_Click" ToolTip="Attach File"/>
                <Button Content="Refresh" Style="{StaticResource ToolbarButton}" Click="Refresh_Click" ToolTip="Refresh"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBackgroundBrush}" Height="24" Padding="4,0"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PathText" Text="C:\Issues\Drafts\"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusConnectedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Connected"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Body: left nav + main content -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="NAVIGATION" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedForegroundBrush}" Margin="8,8,8,4" FontSize="11"/>
                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             Margin="4,0,4,8" Padding="0"
                             SelectionChanged="NavList_SelectionChanged"
                             SelectedIndex="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Content="Dashboard"/>
                        <ListBoxItem Content="New Issue"/>
                        <ListBoxItem Content="My Issues"/>
                        <ListBoxItem Content="Templates"/>
                        <ListBoxItem Content="Settings"/>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main content: New Issue form -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8"
                          Background="{StaticResource WindowBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Issue Details -->
                    <GroupBox Grid.Row="0" Header="Issue Details" Margin="0,0,0,8" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TitleTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5"
                                     Height="22"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Priority:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PriorityCombo" Grid.Row="2" Grid.Column="1" Height="22"
                                      SelectedIndex="0" HorizontalAlignment="Left" Width="120">
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Low"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Category:" VerticalAlignment="Center"
                                       Margin="12,0,0,0" HorizontalAlignment="Right"/>
                            <ComboBox x:Name="CategoryCombo" Grid.Row="2" Grid.Column="3" Height="22"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Hardware"/>
                                <ComboBoxItem Content="Software"/>
                                <ComboBoxItem Content="Network"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <!-- Description -->
                    <GroupBox Grid.Row="1" Header="Description" Margin="0,0,0,8" Padding="8" MinHeight="140">
                        <TextBox x:Name="DescriptionTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="100"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Top"
                                 Padding="4"/>
                    </GroupBox>

                    <!-- Attachments -->
                    <GroupBox Grid.Row="2" Header="Attachments" Margin="0,0,0,8" Padding="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add..." Width="72" Height="22"
                                    VerticalAlignment="Top" Margin="8,0,0,0"
                                    Style="{StaticResource FlatButton}" Click="Attach_Click"/>
                            <ListView x:Name="AttachmentsList" Height="80">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="File Name" Width="280" DisplayMemberBinding="{Binding}"/>
                                        <GridViewColumn Header="Size" Width="80"/>
                                        <GridViewColumn Header="Type" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>

                    <!-- Equipment -->
                    <GroupBox Grid.Row="3" Header="Equipment" Margin="0,0,0,8" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Machine ID:" VerticalAlignment="Center"/>
                            <TextBox x:Name="MachineIdTextBox" Grid.Column="1" Height="22"
                                     Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="2" Text="Location:" VerticalAlignment="Center"/>
                            <TextBox x:Name="LocationTextBox" Grid.Column="3" Height="22"
                                     Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="4" Text="Reporter:" VerticalAlignment="Center"/>
                            <TextBox x:Name="ReporterTextBox" Grid.Column="5" Height="22"/>
                        </Grid>
                    </GroupBox>

                    <!-- Bottom-right action buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,4">
                        <Button Content="Save Draft" Width="100" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource FlatButton}" Click="SaveDraft_Click"/>
                        <Button Content="Submit" Style="{StaticResource AccentButton}"
                                Width="100" Height="26" Margin="0" Click="Submit_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
